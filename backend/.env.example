# PostgreSQL (local defaults match docker-compose postgres service)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=businessassistant
DB_USER=postgres
DB_PASSWORD=postgres

# Shared secret between backend and ai-services
INTERNAL_API_KEY=internal-dev-api-key-change-in-production

# JWT (access default 15 min, refresh default 7 days)
# JWT_ACCESS_EXPIRATION_MS=900000
# JWT_REFRESH_EXPIRATION_MS=604800000
# AI_SERVICES_URL=http://localhost:8000
# CORS_ORIGINS=http://localhost:3000
# JWT_SECRET=your-secret-at-least-32-characters-long
